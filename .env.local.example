# --- Fork ANM (ver ADAPTACAO-ANM.md) --------------------------------------------
# Login via Login Único gov.br (lib/auth/govbr-provider.ts). Client_id/client_secret
# obtidos junto à equipe do Login Único (integracaoid@gestao.gov.br), staging primeiro.
# GOVBR_ISSUER_BASE_URL="https://sso.staging.acesso.gov.br"
# GOVBR_CLIENT_ID="***OBTIDO_NO_CREDENCIAMENTO***"
# GOVBR_CLIENT_SECRET="***OBTIDO_NO_CREDENCIAMENTO***"
# GOVBR_SCOPE="openid email profile"

# Cliente SOAP para o SEI-ANM (lib/interop/sei-anm-soap-client.ts). WSDL e credencial
# de Sistema Externo obtidos com a TI/administração do SEI-ANM.
# SEI_ANM_WSDL_URL="https://sei.anm.gov.br/sei/controlador_ws.php?servico=sei&wsdl"
# SEI_ANM_SIGLA_SISTEMA="APOIAANM"
# SEI_ANM_IDENTIFICACAO_SERVICO="***SENHA_DE_SERVICO_CADASTRADA_NO_SEI***"
# SEI_ANM_ID_UNIDADE="***ID_DA_UNIDADE_SEI***"

# Obrigatório para o login gov.br funcionar em produção: assertCourtId (lib/user.ts)
# usa este mapeamento para resolver o "tribunal" (aqui, a própria ANM) a partir do
# campo `system` que GovBrProvider atribui a todo usuário logado ('ANM' por padrão).
# O número (1 abaixo) é arbitrário — só precisa ser único nesta instância.
# SYSTEM_MAPPING="ANM:1"

# API de busca semântica de temas de repercussão geral (STF) e recursos especiais repetitivos (STJ)
SEMANTIC_SEARCH_API_URL=***SUBSTITUIR_PELA_URL_DA_API***

# Ignorar erros de certificado SSL (útil para modelos on-premises com certificado auto-assinado)
# IGNORE_SSL_ERRORS=true